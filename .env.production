# ============================================
# Thakkar Medico — Production Environment
# ============================================
# Copy from your PRODUCTION Supabase project:
#   Dashboard → Project Settings → API
# IMPORTANT: Use a SEPARATE Supabase project for production!

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# App environment identifier
EXPO_PUBLIC_APP_ENV=production

# Support contact
EXPO_PUBLIC_SUPPORT_PHONE=

# Notification provider: twilio | msg91
NOTIFY_PROVIDER=twilio

# Get DSN from sentry.io after creating project
EXPO_PUBLIC_SENTRY_DSN=
