{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/track/:orderId", "destination": "/track.html" },
    { "source": "/track/:orderId/", "destination": "/track.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/track/", "destination": "/track.html" },
    { "source": "/track.html", "destination": "/track.html" },
    { "source": "/address-correction", "destination": "/index.html" },
    { "source": "/admin/address-correction", "destination": "/index.html" },
    { "source": "/admin-dashboard/address-correction", "destination": "/index.html" },
    { "source": "/admin-dashboard/:path*", "destination": "/admin-dashboard/:path*" },
    { "source": "/admin-dashboard", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/styles.css", "destination": "/styles.css" },
    { "source": "/app.js", "destination": "/app.js" },
    { "source": "/", "destination": "/index.html" }
  ]
}
