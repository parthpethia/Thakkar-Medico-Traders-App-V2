{
  "name": "thakkar-medico-traders",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start",
    "start:go": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --go --clear",
    "start:lowmem": "node --max-old-space-size=6144 ./node_modules/expo/bin/cli start --clear",
    "check:supabase": "node ./scripts/check-supabase.js",
    "verify:schema": "node ./scripts/verify-supabase-schema.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.13.4",
    "date-fns": "^4.1.0",
    "expo": "~54.0.35",
    "expo-battery": "^57.0.1",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "i18next": "^26.3.1",
    "mysql2": "^3.20.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-razorpay": "^2.3.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "supabase": "^2.106.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.11"
  },
  "private": true,
  "devDependencies": {
    "@react-native-community/cli": "latest",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.2",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "@react-native-community/netinfo": "<rootDir>/__tests__/mocks/netinfo.ts"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|react-native-get-random-values|@react-native(-community)?|expo[^/]*|@expo[^/]*/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|@supabase/supabase-js|uuid|i18next|react-i18next|zustand|date-fns)/)"
    ],
    "setupFiles": [
      "./__tests__/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__tests__/setup.ts",
      "__tests__/mocks/"
    ]
  }
}
