# Copy this file to `.env` and fill in values from your Supabase project:
# Dashboard → Project Settings → API → Project URL + anon public key
#
# FIRST-TIME DATABASE: Supabase Dashboard → SQL Editor → run file:
#   supabase/setup.sql
# Then: npm run verify:schema
#
# Auth setup (Authentication → Providers):
#   Email → ENABLED, "Confirm email" → OFF
#   Phone → DISABLED (phone is stored in profiles, not used for Supabase Auth)

EXPO_PUBLIC_SUPABASE_URL=https://dbmnznmuomansrivyvfy.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRibW56bm11b21hbnNyaXZ5dmZ5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ5NzU3MDQsImV4cCI6MjA5MDU1MTcwNH0.1zD45Ne1e0CyMbVIWkTgvcA75gNlZVJib9Ti9SUAm-g

# Upstash Redis (Free Tier — Hot Path Live Location Cache)
EXPO_PUBLIC_UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
EXPO_PUBLIC_UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# RATIO REQUIREMENT: EXPO_PUBLIC_REDIS_POSITION_TTL_SECONDS MUST be >= 2-3x the Postgres sync interval.
# Default: 90s TTL vs 30s Postgres sync. This prevents Redis keys from expiring during network jitter.
EXPO_PUBLIC_REDIS_POSITION_TTL_SECONDS=90
EXPO_PUBLIC_POSTGRES_SYNC_INTERVAL_MS=30000

# GPS write interval (Option 1: 10s default — supports 5-6 concurrent riders under Upstash 500K monthly ceiling)
EXPO_PUBLIC_GPS_UPDATE_INTERVAL_MS=10000

# Optional — Google Maps (Places, Geocoding, map pin on checkout)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Bill OCR / Photo-to-Order Gemini AI key
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional — Dedicated/Self-hosted OSRM Routing Endpoint
EXPO_PUBLIC_OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
EXPO_PUBLIC_OSRM_MIRROR_URL=https://routing.openstreetmap.de/routed-car/route/v1/driving
